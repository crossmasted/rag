# 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# 生成模型（ollama 模式）
CHAT_MODEL=qwen2.5:3b
# 嵌入模型
EMBED_MODEL=bge-m3

# 生成提供商: ollama（本地）或 dashscope（云端 API）
LLM_PROVIDER=ollama
# DashScope（通义千问）API Key，仅 LLM_PROVIDER=dashscope 时使用
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# Qdrant 向量库配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 并发控制（最大同时处理请求数）
MAX_CONCURRENT=5

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag
MYSQL_PASSWORD=rag_pass
MYSQL_DATABASE=rag_kb

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# 访问权限级别（默认）
# 可选值: public, admin, private
DEFAULT_ACCESS_LEVEL=public
